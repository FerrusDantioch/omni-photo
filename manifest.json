{
  "name": "Omni-Photo — montage photo",
  "short_name": "Omni-Photo",
  "description": "Le montage photo tout simple, sur téléphone et tablette : textes, images, calques, puis PNG ou JPG. Gratuit, sans publicité, fonctionne hors ligne. Tes photos restent sur ton appareil.",
  "id": "/omni-photo/",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14111d",
  "theme_color": "#14111d",
  "categories": [
    "photo",
    "utilities"
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titre",
      "text": "texte",
      "files": [
        {
          "name": "photos",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
